# Database Connection
# By default, SQLite is used so students don't need to install PostgreSQL to run the project.
DATABASE_URL=sqlite:///database.db

# If you have PostgreSQL installed and running, uncomment and set your credentials:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# JWT Secret & Algorithm (change SECRET_KEY in production)
SECRET_KEY=super-secret-jwt-key-replace-in-production-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
